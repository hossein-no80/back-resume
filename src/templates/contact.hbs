<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
    h2 { color: #333; }
    .field { margin-bottom: 15px; }
    .label { font-weight: bold; }
  </style>
</head>
<body>
<div class="container">
  <h2>پیام جدید از سایت</h2>
  <div class="field"><span class="label">نام:</span> {{name}}</div>
  <div class="field"><span class="label">ایمیل:</span> {{email}}</div>
  <div class="field"><span class="label">موضوع:</span> {{subject}}</div>
  <div class="field"><span class="label">متن پیام:</span></div>
  <div>{{{message}}}</div>
</div>
</body>
</html>